# Base PostgreSQL (Neon). Récupérez les deux URL avec : npx vercel env pull .env
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Stockage des images en ligne (Vercel Blob). Vide = dossier local uploads/
BLOB_READ_WRITE_TOKEN=""

# Adresse publique de l'app (sert aux liens de retour Stripe)
APP_URL="http://localhost:3000"

# Stripe — clés de TEST depuis https://dashboard.stripe.com/test/apikeys
# Laissez vide pour utiliser le paiement de démonstration.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Commission de la plateforme sur chaque vente, en pourcentage
PLATFORM_FEE_PERCENT="2"
