# Base de données (SQLite en local)
DATABASE_URL="file:./dev.db"

# Stockage des images en ligne (Vercel Blob). Vide = dossier local uploads/
BLOB_READ_WRITE_TOKEN=""

# Adresse publique de l'app (sert aux liens de retour Stripe)
APP_URL="http://localhost:3000"

# Stripe — clés de TEST depuis https://dashboard.stripe.com/test/apikeys
# Laissez vide pour utiliser le paiement de démonstration.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Commission de la plateforme sur chaque vente, en pourcentage
PLATFORM_FEE_PERCENT="2"

# E-mails (Resend, https://resend.com). Sans clé, les e-mails sont seulement enregistrés
# et visibles dans l'admin (Paramètres → Notifications).
RESEND_API_KEY=""
MAIL_FROM="Parnassa Pay <onboarding@resend.dev>"

# Secret du rapport quotidien (appel de /api/cron/daily-report chaque matin)
CRON_SECRET=""

# Administrateurs de la plateforme : accès à la page « Erreurs » et alertes e-mail en cas d'erreur serveur
PLATFORM_ADMINS="vous@exemple.fr"
