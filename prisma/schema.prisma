generator client {
  provider = "prisma-client-js"
}

// SQLite en local. Pour la mise en ligne, passez provider à "postgresql" (voir README).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  dailyReport  Boolean       @default(true) // rapport quotidien par e-mail (toutes ses boutiques)
  createdAt    DateTime      @default(now())
  sessions     Session[]
  stores       Store[]
  memberships  StoreMember[]
}

model Session {
  id        String   @id // hash SHA-256 du jeton du cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Store {
  id                    String          @id @default(cuid())
  slug                  String          @unique
  name                  String
  tagline               String          @default("")
  currency              String          @default("EUR")
  shippingCents         Int             @default(490)
  freeShippingFromCents Int             @default(6000)
  theme                 String // JSON, voir src/lib/theme.ts
  themeUpdatedAt        DateTime?
  stripeAccountId       String?
  stripeChargesEnabled  Boolean         @default(false)
  displayCurrencies     String          @default("[]") // JSON : { code, rate }[] — devises d'affichage et leur taux par rapport à la devise de la boutique
  loyaltyEnabled        Boolean         @default(false) // programme de fidélité
  loyaltyPointsPerUnit  Int             @default(1) // points gagnés par unité de devise dépensée (1 € = 1 point)
  loyaltyRewardPoints   Int             @default(100) // points nécessaires pour un bon
  loyaltyRewardCents    Int             @default(500) // valeur du bon
  autoCartReminder      Boolean         @default(false) // relance automatique des paniers abandonnés
  cartReminderHours     Int             @default(4)
  autoReviewRequest     Boolean         @default(false) // demande d'avis après expédition
  reviewRequestDays     Int             @default(7)
  returnsEnabled        Boolean         @default(true) // retours en libre-service depuis « Mon compte »
  returnWindowDays      Int             @default(30)
  returnInstructions    String          @default("") // adresse de retour, emballage… envoyé à l'acceptation
  lowStockThreshold     Int             @default(3) // alerte e-mail quand une variante passe sous ce seuil
  taxRateBps            Int             @default(2000) // TVA incluse dans les prix, en points de base (2000 = 20 %) ; 0 = franchise
  legalName             String          @default("") // pour les factures
  legalAddress          String          @default("")
  siret                 String          @default("")
  vatNumber             String          @default("")
  ownerId               String
  owner                 User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt             DateTime        @default(now())
  products              Product[]
  collections           Collection[]
  orders                Order[]
  customers             Customer[]
  discounts             Discount[]
  members               StoreMember[]
  invites               StoreInvite[]
  shippingZones         ShippingZone[]
  checkouts             Checkout[]
  reviews               Review[]
  pages                 Page[]
  posts                 BlogPost[]
  giftCards             GiftCard[]
  campaigns             Campaign[]
  subscriptions         Subscription[]
  returns               ReturnRequest[]
}

/// Abonnement d'un client à un produit : une commande est créée à chaque échéance.
model Subscription {
  id                   String   @id @default(cuid())
  storeId              String
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId           String?
  email                String
  name                 String
  address              String // JSON, comme sur les commandes
  variantId            String
  productTitle         String
  variantTitle         String
  quantity             Int
  priceCents           Int // prix par échéance (remise abonné comprise)
  interval             String // week | month
  status               String   @default("active") // active | paused | cancelled
  nextBillingAt        DateTime
  ordersCount          Int      @default(1)
  firstOrderId         String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Campagne e-mail envoyée aux abonnés de la newsletter.
model Campaign {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subject    String
  title      String    @default("")
  body       String    @default("")
  productIds String    @default("[]") // JSON : produits mis en avant
  buttonText String    @default("Découvrir")
  status     String    @default("draft") // draft | sent
  recipients Int       @default(0)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// Page de contenu (À propos, CGV, FAQ…). Mise en forme simple : ## titre, **gras**, listes « - », [lien](url).
model Page {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String
  handle         String
  body           String   @default("")
  published      Boolean  @default(true)
  showInFooter   Boolean  @default(true)
  seoTitle       String   @default("")
  seoDescription String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([storeId, handle])
}

model BlogPost {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String
  handle         String
  excerpt        String    @default("")
  body           String    @default("")
  image          String?
  author         String    @default("")
  published      Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String    @default("")
  seoDescription String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([storeId, handle])
}

model GiftCard {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code         String // 16 caractères en majuscules, sans espaces
  initialCents Int
  balanceCents Int
  email        String    @default("")
  note         String    @default("")
  orderId      String? // commande qui a acheté cette carte, le cas échéant
  disabled     Boolean   @default(false)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([storeId, code])
}

/// Zone d'expédition : un groupe de pays et ses tarifs.
model ShippingZone {
  id        String         @id @default(cuid())
  storeId   String
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  countries String         @default("[]") // JSON: string[] (noms de pays)
  rates     ShippingRate[]
  createdAt DateTime       @default(now())
}

model ShippingRate {
  id             String       @id @default(cuid())
  zoneId         String
  zone           ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name           String // « Standard », « Express »…
  priceCents     Int
  freeAboveCents Int? // gratuit à partir de ce montant
  position       Int          @default(0)
}

/// Panier d'un client qui a donné son e-mail sans terminer sa commande.
model Checkout {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  token       String    @unique // jeton du lien de récupération
  email       String
  name        String    @default("")
  items       String // JSON: { variantId, quantity }[]
  totalCents  Int       @default(0)
  orderId     String? // rempli quand le client a commandé
  remindedAt  DateTime?
  recoveredAt DateTime? // commande passée après une relance
  activityAt  DateTime  @default(now()) // dernière modification du panier par le client
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, email])
}

/// Avis client sur un produit, publié après modération.
model Review {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  email     String
  rating    Int
  title     String   @default("")
  body      String
  status    String   @default("pending") // pending | published | hidden
  verified  Boolean  @default(false) // le client a acheté ce produit
  createdAt DateTime @default(now())
}

/// Collaborateurs d'une boutique (le propriétaire reste Store.owner).
model StoreMember {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String   @default("[\"orders\",\"products\",\"customers\",\"discounts\",\"analytics\",\"content\"]") // JSON : zones accessibles
  createdAt   DateTime @default(now())

  @@unique([storeId, userId])
}

model StoreInvite {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email      String
  token      String    @unique // hash SHA-256 du jeton envoyé dans le lien
  invitedBy  String
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
}

model Product {
  id                      String              @id @default(cuid())
  storeId                 String
  store                   Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title                   String
  handle                  String
  description             String              @default("")
  status                  String              @default("draft") // draft | active
  images                  String              @default("[]") // JSON: string[]
  options                 String              @default("[]") // JSON: { name, values[] }[]
  hue                     Int                 @default(160) // couleur du visuel quand il n'y a pas de photo
  seoTitle                String              @default("")
  seoDescription          String              @default("")
  isGiftCard              Boolean             @default(false) // vendu comme carte cadeau : pas de stock, pas de livraison
  continueSelling         Boolean             @default(false) // précommande : vendable même en rupture de stock
  subscriptionInterval    String? // abonnement proposé : "week" | "month" (null = pas d'abonnement)
  subscriptionDiscountBps Int                 @default(0) // remise pour les abonnés (1000 = 10 %)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  variants                Variant[]
  collections             ProductCollection[]
  reviews                 Review[]
  bundleItems             BundleItem[]        @relation("BundleItems")

  @@unique([storeId, handle])
}

model Variant {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String // "M / Bleu", ou "Par défaut"
  optionValues   String  @default("[]") // JSON: string[] dans l'ordre des options
  priceCents     Int
  compareAtCents Int?
  sku            String  @default("")
  stock          Int     @default(0)
  position       Int     @default(0)
}

model Collection {
  id             String              @id @default(cuid())
  storeId        String
  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String
  handle         String
  description    String              @default("")
  image          String?
  seoTitle       String              @default("")
  seoDescription String              @default("")
  createdAt      DateTime            @default(now())
  products       ProductCollection[]

  @@unique([storeId, handle])
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Customer {
  id               String    @id @default(cuid())
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email            String
  name             String
  note             String    @default("") // note interne, visible seulement dans l'admin
  acceptsMarketing Boolean   @default(false) // abonné à la newsletter
  points           Int       @default(0) // solde de points de fidélité
  marketingToken   String?   @unique // jeton du lien de désabonnement
  subscribedAt     DateTime?
  createdAt        DateTime  @default(now())
  orders           Order[]

  @@unique([storeId, email])
}

model Discount {
  id               String    @id @default(cuid())
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code             String // toujours en majuscules
  type             String // percent | fixed | free_shipping
  value            Int // pourcentage, ou centimes pour fixed
  minSubtotalCents Int       @default(0)
  usageLimit       Int?
  usageCount       Int       @default(0)
  active           Boolean   @default(true)
  automatic        Boolean   @default(false) // appliquée sans code dans le panier
  customerEmail    String? // bon de fidélité : utilisable seulement par ce client
  title            String    @default("") // nom affiché pour une remise automatique
  endsAt           DateTime?
  createdAt        DateTime  @default(now())

  @@unique([storeId, code])
}

model Order {
  id                    String          @id @default(cuid())
  storeId               String
  store                 Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  number                Int
  customerId            String?
  customer              Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email                 String
  name                  String
  address               String // JSON: { line1, zip, city, country }
  note                  String          @default("")
  paymentStatus         String          @default("pending") // pending | paid | refunded
  fulfillmentStatus     String          @default("unfulfilled") // unfulfilled | fulfilled
  cancelledAt           DateTime?
  subtotalCents         Int
  discountCents         Int             @default(0)
  discountCode          String?
  giftCardCode          String?
  giftCardCents         Int             @default(0)
  discountId            String? // remise appliquée (code ou automatique), pour compter ses utilisations
  stripePaymentIntentId String? // paiement Stripe à rembourser (y compris pour les abonnements)
  stripeInvoiceId       String?         @unique // facture Stripe d'un renouvellement (évite les doublons)
  shippingCents         Int
  totalCents            Int
  paymentMethod         String          @default("demo") // demo | stripe | manual
  shippingMethod        String          @default("")
  stripeSessionId       String?         @unique
  paidAt                DateTime?
  createdAt             DateTime        @default(now())
  refundedCents         Int             @default(0)
  subscriptionId        String? // commande de renouvellement d'un abonnement
  fulfilledAt           DateTime?
  reviewRequestedAt     DateTime?
  taxRateBps            Int             @default(0) // taux de TVA au moment de la commande
  taxCents              Int             @default(0) // TVA comprise dans le total
  items                 OrderItem[]
  events                OrderEvent[]
  refunds               Refund[]
  returns               ReturnRequest[]

  @@unique([storeId, number])
}

/// Chronologie d'une commande : actions du marchand et commentaires internes.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // comment | fulfilled | unfulfilled | cancelled | refunded
  message   String   @default("")
  author    String   @default("")
  createdAt DateTime @default(now())
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  order                Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId            String? // pas de relation : la commande garde sa trace même si la variante est supprimée
  productTitle         String
  variantTitle         String
  priceCents           Int
  quantity             Int
  image                String?
  hue                  Int     @default(160)
  refundedQuantity     Int     @default(0)
  isGiftCard           Boolean @default(false)
  subscriptionInterval String? // article pris en abonnement
}

/// Remboursement (total ou partiel) d'une commande, avec ou sans retour en stock.
model Refund {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents    Int
  shippingCents  Int      @default(0)
  items          String   @default("[]") // JSON: { orderItemId, quantity }[]
  restock        Boolean  @default(true)
  reason         String   @default("")
  stripeRefundId String?
  author         String   @default("")
  createdAt      DateTime @default(now())
}

/// Journal des e-mails : envoyés via Resend, ou seulement enregistrés quand aucune clé n'est configurée.
model MailLog {
  id        String   @id @default(cuid())
  storeId   String?
  to        String
  subject   String
  html      String
  status    String // sent | logged | failed
  error     String?
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Connexion des clients à leur compte, par code reçu par e-mail (sans mot de passe).
model CustomerLoginCode {
  id        String   @id @default(cuid())
  storeId   String
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([storeId, email])
}

model CustomerSession {
  id         String   @id // hash SHA-256 du jeton du cookie
  customerId String
  storeId    String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

/// Journal d'activité : qui a fait quoi dans l'admin d'une boutique.
model ActivityLog {
  id        String   @id @default(cuid())
  storeId   String
  userId    String?
  userName  String
  action    String
  url       String?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

/// Composant d'un lot : le lot (un produit) contient « quantity » exemplaires d'une variante d'un autre produit.
model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Product @relation("BundleItems", fields: [bundleId], references: [id], onDelete: Cascade)
  variantId String
  quantity  Int     @default(1)

  @@unique([bundleId, variantId])
}

/// Mouvements de points de fidélité (gains, échanges, retraits, ajustements).
model LoyaltyEntry {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  points     Int
  reason     String
  orderId    String?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

/// Compteur de limitation (tentatives de connexion, demandes de code) : une ligne par clé et par fenêtre.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

/// Demande de retour d'un client : demandé → accepté (ou refusé) → reçu → remboursé.
model ReturnRequest {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        String    @default("requested") // requested | approved | declined | received | refunded
  items         String // JSON: { orderItemId, quantity, reason }[]
  note          String    @default("") // commentaire du client
  declineReason String    @default("")
  approvedAt    DateTime?
  receivedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([storeId, status])
  @@index([orderId])
}
