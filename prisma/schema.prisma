generator client {
  provider = "prisma-client-js"
}

// SQLite en local. En production (DATABASE_URL postgres://…), scripts/prisma.mjs utilise automatiquement PostgreSQL.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  passwordHash    String
  dailyReport     Boolean       @default(true) // rapport quotidien par e-mail (toutes ses boutiques)
  termsAcceptedAt DateTime? // acceptation des conditions d'utilisation à l'inscription
  totpSecret      String? // double authentification : clé de l'application (base32), active si totpEnabled
  totpPending     String? // clé en cours d'activation (pas encore confirmée par un code)
  totpEnabled     Boolean       @default(false)
  totpLastStep    Int? // dernier pas de 30 s utilisé : un même code ne sert qu'une fois
  recoveryCodes   String        @default("[]") // JSON : empreintes des codes de secours restants
  createdAt       DateTime      @default(now())
  sessions        Session[]
  stores          Store[]
  memberships     StoreMember[]
}

model Session {
  id        String   @id // hash SHA-256 du jeton du cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Store {
  id                       String                @id @default(cuid())
  slug                     String                @unique
  domain                   String?               @unique // nom de domaine personnalisé (ex. www.maboutique.fr)
  domainToken              String? // valeur de l'enregistrement TXT qui prouve que le domaine appartient au marchand
  domainVerifiedAt         DateTime? // la boutique n'est servie sur ce domaine qu'une fois vérifié
  // Forfait du marchand (facturation de la plateforme)
  plan                     String                @default("trial") // trial | essentiel | pro | avance
  planStatus               String                @default("trialing") // trialing | active | past_due | canceled
  trialEndsAt              DateTime? // fin de l'essai gratuit (null : 14 jours après la création)
  billingCustomerId        String? // client Stripe de la plateforme (le marchand)
  planSubscriptionId       String?               @unique // abonnement Stripe du forfait
  planRenewsAt             DateTime? // prochaine échéance, ou fin d'accès après résiliation
  name                     String
  tagline                  String                @default("")
  languages                String                @default("[\"fr\"]") // JSON : langues de la boutique, la première est la langue principale
  translations             String                @default("{}") // JSON { en: { tagline, passwordMessage } }
  currency                 String                @default("EUR")
  shippingCents            Int                   @default(490)
  freeShippingFromCents    Int                   @default(6000)
  theme                    String // JSON, voir src/lib/theme.ts
  customCss                String                @default("") // CSS personnalisé de la boutique (filtré, sans HTML)
  themeUpdatedAt           DateTime?
  stripeAccountId          String?
  stripeChargesEnabled     Boolean               @default(false)
  displayCurrencies        String                @default("[]") // JSON : { code, rate }[] — devises d'affichage et leur taux par rapport à la devise de la boutique
  chargeInCustomerCurrency Boolean               @default(false) // encaisser dans la devise choisie par le client (sinon affichage seulement)
  autoRates                Boolean               @default(false) // taux de change mis à jour chaque jour (BCE)
  primaryLocationName      String                @default("Entrepôt principal") // emplacement principal (stock en ligne)
  githubInstallationId     Int? // installation de l'application GitHub de la plateforme (connexion sans jeton)
  publishedThemeId         String? // thème publié (bibliothèque de thèmes) ; ses fichiers sont copiés dans theme / customCss / translations
  themes                   StoreTheme[]
  webVitals                WebVital[]
  ratesUpdatedAt           DateTime?
  loyaltyEnabled           Boolean               @default(false) // programme de fidélité
  loyaltyPointsPerUnit     Int                   @default(1) // points gagnés par unité de devise dépensée (1 € = 1 point)
  loyaltyRewardPoints      Int                   @default(100) // points nécessaires pour un bon
  loyaltyRewardCents       Int                   @default(500) // valeur du bon
  autoCartReminder         Boolean               @default(false) // relance automatique des paniers abandonnés
  cartReminderHours        Int                   @default(4)
  autoReviewRequest        Boolean               @default(false) // demande d'avis après expédition
  reviewRequestDays        Int                   @default(7)
  menus                    String                @default("") // JSON { main, footer } : menus de navigation (vide = menus par défaut)
  chatEnabled              Boolean               @default(true) // bulle de discussion sur la boutique
  chatGreeting             String                @default("Bonjour ! Une question sur un produit ou une commande ? Écrivez-nous, nous répondons vite.")
  passwordEnabled          Boolean               @default(false) // boutique protégée par mot de passe (en préparation)
  storePassword            String                @default("") // mot de passe partagé, à donner aux visiteurs
  passwordMessage          String                @default("Notre boutique ouvre très bientôt. Revenez nous voir !")
  gaId                     String                @default("") // Google Analytics 4 (G-XXXXXXX)
  metaPixelId              String                @default("") // Meta (Facebook / Instagram) Pixel
  pickupEnabled            Boolean               @default(false) // retrait en boutique proposé au paiement
  pickupAddress            String                @default("")
  pickupInstructions       String                @default("") // horaires, consignes (pièce d'identité, numéro de commande…)
  emailTemplates           String                @default("{}") // JSON { modèle: { subject, title, intro } } : textes personnalisés des e-mails clients
  returnsEnabled           Boolean               @default(true) // retours en libre-service depuis « Mon compte »
  returnWindowDays         Int                   @default(30)
  returnInstructions       String                @default("") // adresse de retour, emballage… envoyé à l'acceptation
  lowStockThreshold        Int                   @default(3) // alerte e-mail quand une variante passe sous ce seuil
  taxRateBps               Int                   @default(2000) // TVA incluse dans les prix, en points de base (2000 = 20 %) ; 0 = franchise
  vatByCountry             Boolean               @default(false) // TVA du pays de livraison (ventes à distance UE, guichet OSS) et 0 % à l'export
  legalName                String                @default("") // pour les factures
  legalAddress             String                @default("")
  siret                    String                @default("")
  vatNumber                String                @default("")
  ownerId                  String
  owner                    User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt                DateTime              @default(now())
  products                 Product[]
  collections              Collection[]
  orders                   Order[]
  customers                Customer[]
  discounts                Discount[]
  priceLists               PriceList[]
  apiKeys                  ApiKey[]
  webhooks                 Webhook[]
  members                  StoreMember[]
  invites                  StoreInvite[]
  shippingZones            ShippingZone[]
  checkouts                Checkout[]
  reviews                  Review[]
  pages                    Page[]
  posts                    BlogPost[]
  giftCards                GiftCard[]
  campaigns                Campaign[]
  subscriptions            Subscription[]
  returns                  ReturnRequest[]
  redirects                Redirect[]
  segments                 Segment[]
  suppliers                Supplier[]
  purchaseOrders           PurchaseOrder[]
  stockAlerts              StockAlert[]
  conversations            Conversation[]
  metafieldDefinitions     MetafieldDefinition[]
  Location                 Location[]
  // Audit Shopify : réglages supplémentaires
  orderPrefix              String                @default("#") // préfixe du numéro de commande (#1001)
  orderSuffix              String                @default("")
  autoArchive              Boolean               @default(true) // commandes archivées une fois traitées et payées
  fulfillmentDays          Int                   @default(2) // délai de traitement promis (« Traiter avant le »)
  checkoutPhone            String                @default("optional") // hidden | optional | required
  checkoutCompany          String                @default("hidden") // hidden | optional | required
  checkoutAddress2         Boolean               @default(true)
  marketingPreselect       Boolean               @default(false)
  cartLimit                Boolean               @default(true) // limite d'ajout au panier au stock disponible
  manualPayments           String                @default("[]") // JSON [{ key, name, instructions, enabled }] : virement, paiement à la livraison…
  storeCreditEnabled       Boolean               @default(false)
  deliveryMinDays          Int? // dates de livraison estimées affichées au client
  deliveryMaxDays          Int?
  policies                 String                @default("{}") // JSON { returns, privacy, terms, shipping, contact, legal, sale } : { body, published }
  pageViews                PageView[]
  liveVisitors             LiveVisitor[]
  inventoryAdjustments     InventoryAdjustment[]
  customerEvents           CustomerEvent[]
  storeCreditEntries       StoreCreditEntry[]
  mediaFiles               MediaFile[]
  SavedView                SavedView[]
  Market                   Market[]
}

/// Abonnement d'un client à un produit : une commande est créée à chaque échéance.
model Subscription {
  id                   String   @id @default(cuid())
  storeId              String
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId           String?
  email                String
  name                 String
  address              String // JSON, comme sur les commandes
  variantId            String
  productTitle         String
  variantTitle         String
  quantity             Int
  priceCents           Int // prix par échéance (remise abonné comprise)
  interval             String // week | month
  status               String   @default("active") // active | paused | cancelled
  nextBillingAt        DateTime
  ordersCount          Int      @default(1)
  firstOrderId         String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Campagne e-mail envoyée aux abonnés de la newsletter.
model Campaign {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subject    String
  title      String    @default("")
  body       String    @default("")
  productIds String    @default("[]") // JSON : produits mis en avant
  buttonText String    @default("Découvrir")
  status     String    @default("draft") // draft | sent
  recipients Int       @default(0)
  segmentId  String? // destinataires : abonnés de ce segment (vide = tous les abonnés)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// Page de contenu (À propos, CGV, FAQ…). Mise en forme simple : ## titre, **gras**, listes « - », [lien](url).
model Page {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String
  handle         String
  body           String   @default("")
  translations   String   @default("{}") // JSON { en: { title, body } }
  published      Boolean  @default(true)
  showInFooter   Boolean  @default(true)
  seoTitle       String   @default("")
  seoDescription String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([storeId, handle])
}

model BlogPost {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String
  handle         String
  excerpt        String    @default("")
  body           String    @default("")
  image          String?
  author         String    @default("")
  published      Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String    @default("")
  seoDescription String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([storeId, handle])
}

model GiftCard {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code         String // 16 caractères en majuscules, sans espaces
  initialCents Int
  balanceCents Int
  email        String    @default("")
  note         String    @default("")
  orderId      String? // commande qui a acheté cette carte, le cas échéant
  disabled     Boolean   @default(false)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([storeId, code])
}

/// Zone d'expédition : un groupe de pays et ses tarifs.
model ShippingZone {
  id        String         @id @default(cuid())
  storeId   String
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  countries String         @default("[]") // JSON: string[] (noms de pays)
  rates     ShippingRate[]
  createdAt DateTime       @default(now())
}

model ShippingRate {
  id               String       @id @default(cuid())
  zoneId           String
  zone             ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name             String // « Standard », « Express »…
  priceCents       Int
  freeAboveCents   Int? // gratuit à partir de ce montant
  minWeightGrams   Int? // tarif proposé seulement pour un panier de ce poids…
  maxWeightGrams   Int? // …jusqu'à ce poids (inclus)
  minSubtotalCents Int? // et/ou à partir de ce montant
  maxSubtotalCents Int? // jusqu'à ce montant (inclus)
  position         Int          @default(0)
}

/// Panier d'un client qui a donné son e-mail sans terminer sa commande.
model Checkout {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  token       String    @unique // jeton du lien de récupération
  email       String
  name        String    @default("")
  items       String // JSON: { variantId, quantity }[]
  totalCents  Int       @default(0)
  orderId     String? // rempli quand le client a commandé
  remindedAt  DateTime?
  recoveredAt DateTime? // commande passée après une relance
  activityAt  DateTime  @default(now()) // dernière modification du panier par le client
  locale      String    @default("fr") // langue du client (e-mail de relance)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, email])
}

/// Avis client sur un produit, publié après modération.
model Review {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  email     String
  rating    Int
  title     String   @default("")
  body      String
  status    String   @default("pending") // pending | published | hidden
  verified  Boolean  @default(false) // le client a acheté ce produit
  createdAt DateTime @default(now())
}

/// Collaborateurs d'une boutique (le propriétaire reste Store.owner).
model StoreMember {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String   @default("[\"orders\",\"products\",\"customers\",\"discounts\",\"analytics\",\"content\"]") // JSON : zones accessibles
  createdAt   DateTime @default(now())

  @@unique([storeId, userId])
}

model StoreInvite {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email      String
  token      String    @unique // hash SHA-256 du jeton envoyé dans le lien
  invitedBy  String
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
}

model Product {
  id                      String              @id @default(cuid())
  storeId                 String
  store                   Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title                   String
  handle                  String
  description             String              @default("")
  translations            String              @default("{}") // JSON { en: { title, description, seoTitle, seoDescription } }
  status                  String              @default("draft") // draft | active
  images                  String              @default("[]") // JSON: string[]
  options                 String              @default("[]") // JSON: { name, values[] }[]
  hue                     Int                 @default(160) // couleur du visuel quand il n'y a pas de photo
  seoTitle                String              @default("")
  seoDescription          String              @default("")
  isGiftCard              Boolean             @default(false) // vendu comme carte cadeau : pas de stock, pas de livraison
  continueSelling         Boolean             @default(false) // précommande : vendable même en rupture de stock
  subscriptionInterval    String? // abonnement proposé : "week" | "month" (null = pas d'abonnement)
  subscriptionDiscountBps Int                 @default(0) // remise pour les abonnés (1000 = 10 %)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  variants                Variant[]
  collections             ProductCollection[]
  reviews                 Review[]
  bundleItems             BundleItem[]        @relation("BundleItems")
  metafields              String              @default("{}") // JSON { clé: valeur } des champs personnalisés
  complementaryIds        String              @default("[]") // JSON : produits complémentaires choisis (« Souvent achetés ensemble »)
  vendor                  String              @default("")
  productType             String              @default("")
  tags                    String              @default("") // balises séparées par des virgules
  category                String              @default("")
  taxable                 Boolean             @default(true)

  @@unique([storeId, handle])
}

model Variant {
  id             String                @id @default(cuid())
  productId      String
  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String // "M / Bleu", ou "Par défaut"
  optionValues   String                @default("[]") // JSON: string[] dans l'ordre des options
  priceCents     Int
  compareAtCents Int?
  costCents      Int? // coût d'achat par article (marge)
  image          String? // photo de cette variante (une des photos du produit)
  weightGrams    Int                   @default(0) // poids pour les tarifs d'expédition
  sku            String                @default("")
  stock          Int                   @default(0)
  position       Int                   @default(0)
  levels         InventoryLevel[]
  barcode        String                @default("")
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  adjustments    InventoryAdjustment[]
}

model Collection {
  id             String              @id @default(cuid())
  storeId        String
  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String
  handle         String
  description    String              @default("")
  translations   String              @default("{}") // JSON { en: { title, description } }
  image          String?
  seoTitle       String              @default("")
  seoDescription String              @default("")
  createdAt      DateTime            @default(now())
  products       ProductCollection[]

  @@unique([storeId, handle])
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Customer {
  id                String             @id @default(cuid())
  storeId           String
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email             String
  name              String
  note              String             @default("") // note interne, visible seulement dans l'admin
  tags              String             @default("") // étiquettes séparées par des virgules (ex. « vip, grossiste »)
  phone             String             @default("")
  address           String             @default("") // JSON { line1, zip, city, country } : adresse par défaut (import, commandes manuelles)
  acceptsMarketing  Boolean            @default(false) // abonné à la newsletter
  points            Int                @default(0) // solde de points de fidélité
  marketingToken    String?            @unique // jeton du lien de désabonnement
  subscribedAt      DateTime?
  createdAt         DateTime           @default(now())
  orders            Order[]
  // B2B : client professionnel
  company           String             @default("")
  vatNumber         String             @default("") // numéro de TVA intracommunautaire
  vatValid          Boolean? // résultat VIES : true valide, false invalide, null pas encore vérifié (ou VIES indisponible)
  vatCheckedAt      DateTime?
  vatRegisteredName String             @default("") // raison sociale enregistrée auprès de VIES
  priceListId       String?
  priceList         PriceList?         @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  paymentTermsDays  Int                @default(0) // 0 = paiement à la commande ; 15, 30, 45, 60 = paiement à échéance
  taxExempt         Boolean            @default(false)
  locale            String             @default("fr")
  storeCreditCents  Int                @default(0)
  events            CustomerEvent[]
  creditEntries     StoreCreditEntry[]

  @@unique([storeId, email])
}

/// Liste de prix professionnels : une réduction sur tout le catalogue, et/ou des prix fixes par variante.
model PriceList {
  id         String           @id @default(cuid())
  storeId    String
  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  percentOff Int              @default(0) // réduction générale en pourcentage (0 à 90)
  createdAt  DateTime         @default(now())
  prices     PriceListPrice[]
  customers  Customer[]
}

model PriceListPrice {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variantId   String
  priceCents  Int

  @@unique([priceListId, variantId])
}

model Discount {
  id                   String    @id @default(cuid())
  storeId              String
  store                Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code                 String // toujours en majuscules
  type                 String // percent | fixed | free_shipping | bxgy
  value                Int // pourcentage, ou centimes pour fixed
  minSubtotalCents     Int       @default(0)
  usageLimit           Int?
  usageCount           Int       @default(0)
  active               Boolean   @default(true)
  automatic            Boolean   @default(false) // appliquée sans code dans le panier
  customerEmail        String? // bon de fidélité : utilisable seulement par ce client
  title                String    @default("") // nom affiché pour une remise automatique
  endsAt               DateTime?
  startsAt             DateTime? // remise programmée : active à partir de cette date
  appliesTo            String    @default("all") // all | collections | products
  targetIds            String    @default("[]") // JSON : collections ou produits concernés
  buyQty               Int       @default(0) // « Achetez X, obtenez Y » : X
  getQty               Int       @default(0) // Y (réduction de value % sur ces articles, 100 = offerts)
  oncePerCustomer      Boolean   @default(false)
  combinesWithShipping Boolean   @default(false) // remise produits cumulable avec une livraison offerte (et inversement pour une livraison offerte)
  createdAt            DateTime  @default(now())
  minQuantity          Int       @default(0)
  eligibility          String    @default("all") // all | segments | customers
  eligibleIds          String    @default("[]") // JSON : segments ou clients concernés
  countries            String    @default("[]") // livraison offerte : pays concernés ("[]" = tous)

  @@unique([storeId, code])
}

model Order {
  id                    String          @id @default(cuid())
  storeId               String
  store                 Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  number                Int
  customerId            String?
  customer              Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email                 String
  name                  String
  address               String // JSON: { line1, zip, city, country }
  note                  String          @default("")
  paymentStatus         String          @default("pending") // pending | paid | refunded
  fulfillmentStatus     String          @default("unfulfilled") // unfulfilled | fulfilled
  cancelledAt           DateTime?
  subtotalCents         Int
  discountCents         Int             @default(0)
  discountCode          String?
  giftCardCode          String?
  giftCardCents         Int             @default(0)
  discountId            String? // remise appliquée (code ou automatique), pour compter ses utilisations
  shippingDiscountId    String? // livraison offerte cumulée avec la remise principale
  fulfillmentLocationId String? // emplacement d'où la commande est partie (null : emplacement principal)
  stripePaymentIntentId String? // paiement Stripe à rembourser (y compris pour les abonnements)
  stripeInvoiceId       String?         @unique // facture Stripe d'un renouvellement (évite les doublons)
  shippingCents         Int
  totalCents            Int
  paymentMethod         String          @default("demo") // demo | stripe | manual
  locale                String          @default("fr") // langue du client au moment de la commande (e-mails)
  reverseCharge         Boolean         @default(false) // vente hors taxes à un professionnel de l'UE (autoliquidation)
  presentmentCurrency   String? // devise payée par le client quand elle diffère de celle de la boutique
  presentmentRate       Float           @default(1) // taux appliqué : 1 unité de la boutique = presentmentRate unités payées
  presentmentTotalCents Int? // total réellement payé dans cette devise
  shippingMethod        String          @default("")
  stripeSessionId       String?         @unique
  paidAt                DateTime?
  createdAt             DateTime        @default(now())
  refundedCents         Int             @default(0)
  subscriptionId        String? // commande de renouvellement d'un abonnement
  fulfilledAt           DateTime?
  trackingCarrier       String          @default("") // transporteur (colissimo, chronopost…) ou nom libre
  trackingNumber        String          @default("")
  trackingUrl           String          @default("") // lien de suivi personnalisé (transporteur « autre »)
  dueAt                 DateTime? // paiement à échéance (client professionnel) : date limite
  stockCommittedAt      DateTime? // stock déjà retiré avant le paiement (commande à échéance)
  payToken              String?         @unique // lien de paiement envoyé avec la facture (commande créée dans l'admin)
  invoiceSentAt         DateTime?
  deliveryMethod        String          @default("shipping") // shipping | pickup
  pickupReadyAt         DateTime? // commande prête à être retirée (client prévenu)
  reviewRequestedAt     DateTime?
  taxRateBps            Int             @default(0) // taux de TVA au moment de la commande
  taxCents              Int             @default(0) // TVA comprise dans le total
  items                 OrderItem[]
  events                OrderEvent[]
  refunds               Refund[]
  returns               ReturnRequest[]
  // Audit Shopify
  tags                  String          @default("") // balises séparées par des virgules
  fulfillBy             DateTime? // « Traiter avant le »
  deliveredAt           DateTime? // statut de la livraison : livrée
  archivedAt            DateTime?
  riskLevel             String          @default("") // "" | low | medium | high
  riskNotes             String          @default("")
  sessionId             String? // visite à l'origine de la commande (attribution)
  referrer              String          @default("")
  utmSource             String          @default("")
  utmMedium             String          @default("")
  utmCampaign           String          @default("")
  visitsBefore          Int? // nombre de visites avant la commande
  paymentInstructions   String          @default("") // moyen de paiement manuel choisi (virement, à la livraison) : consignes
  storeCreditCents      Int             @default(0) // crédit en magasin utilisé sur cette commande

  @@unique([storeId, number])
}

/// Chronologie d'une commande : actions du marchand et commentaires internes.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // comment | fulfilled | unfulfilled | cancelled | refunded
  message   String   @default("")
  author    String   @default("")
  createdAt DateTime @default(now())
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  order                Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId            String? // pas de relation : la commande garde sa trace même si la variante est supprimée
  productTitle         String
  variantTitle         String
  priceCents           Int
  quantity             Int
  image                String?
  hue                  Int     @default(160)
  refundedQuantity     Int     @default(0)
  isGiftCard           Boolean @default(false)
  subscriptionInterval String? // article pris en abonnement
  costCents            Int? // coût par article au moment de la commande
}

/// Remboursement (total ou partiel) d'une commande, avec ou sans retour en stock.
model Refund {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents    Int
  shippingCents  Int      @default(0)
  items          String   @default("[]") // JSON: { orderItemId, quantity }[]
  restock        Boolean  @default(true)
  reason         String   @default("")
  stripeRefundId String?
  author         String   @default("")
  createdAt      DateTime @default(now())
}

/// Journal des e-mails : envoyés via Resend, ou seulement enregistrés quand aucune clé n'est configurée.
model MailLog {
  id        String   @id @default(cuid())
  storeId   String?
  to        String
  subject   String
  html      String
  status    String // sent | logged | failed
  error     String?
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Connexion des clients à leur compte, par code reçu par e-mail (sans mot de passe).
model CustomerLoginCode {
  id        String   @id @default(cuid())
  storeId   String
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([storeId, email])
}

model CustomerSession {
  id         String   @id // hash SHA-256 du jeton du cookie
  customerId String
  storeId    String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

/// Journal d'activité : qui a fait quoi dans l'admin d'une boutique.
model ActivityLog {
  id        String   @id @default(cuid())
  storeId   String
  userId    String?
  userName  String
  action    String
  url       String?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

/// Composant d'un lot : le lot (un produit) contient « quantity » exemplaires d'une variante d'un autre produit.
model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Product @relation("BundleItems", fields: [bundleId], references: [id], onDelete: Cascade)
  variantId String
  quantity  Int     @default(1)

  @@unique([bundleId, variantId])
}

/// Mouvements de points de fidélité (gains, échanges, retraits, ajustements).
model LoyaltyEntry {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  points     Int
  reason     String
  orderId    String?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

/// Compteur de limitation (tentatives de connexion, demandes de code) : une ligne par clé et par fenêtre.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

/// Demande de retour d'un client : demandé → accepté (ou refusé) → reçu → remboursé.
model ReturnRequest {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        String    @default("requested") // requested | approved | declined | received | refunded
  items         String // JSON: { orderItemId, quantity, reason }[]
  note          String    @default("") // commentaire du client
  declineReason String    @default("")
  approvedAt    DateTime?
  receivedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([storeId, status])
  @@index([orderId])
}

/// Redirection d'URL de la boutique : un ancien chemin (ex. /p/ancien-nom) renvoie vers un nouveau.
model Redirect {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fromPath  String // relatif à la boutique, commence par /
  toPath    String // relatif à la boutique (/c/bols) ou adresse complète https://
  hits      Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([storeId, fromPath])
}

/// Segment de clients : un groupe défini par des conditions (commandes, montant dépensé, étiquettes…), recalculé à chaque affichage.
model Segment {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  match     String   @default("all") // all : toutes les conditions | any : au moins une
  rules     String   @default("[]") // JSON : { field, op, value }[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Fournisseur de la boutique (bons de commande).
model Supplier {
  id        String          @id @default(cuid())
  storeId   String
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  email     String          @default("")
  phone     String          @default("")
  address   String          @default("")
  createdAt DateTime        @default(now())
  orders    PurchaseOrder[]
}

/// Bon de commande fournisseur : brouillon → commandé → reçu (en partie ou en totalité). La réception augmente le stock.
model PurchaseOrder {
  id            String              @id @default(cuid())
  storeId       String
  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  number        Int
  supplierId    String?
  supplier      Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status        String              @default("draft") // draft | ordered | partial | received | cancelled
  expectedAt    DateTime?
  shippingCents Int                 @default(0)
  note          String              @default("")
  orderedAt     DateTime?
  receivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  items         PurchaseOrderItem[]

  @@unique([storeId, number])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId       String? // pas de relation : le bon garde sa trace si la variante est supprimée
  productTitle    String
  variantTitle    String
  sku             String        @default("")
  quantity        Int
  received        Int           @default(0)
  costCents       Int           @default(0)
}

/// « Me prévenir du retour en stock » : un client attend qu'une variante épuisée revienne.
model StockAlert {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variantId  String
  email      String
  locale     String    @default("fr") // langue du client (e-mail de retour en stock)
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([variantId, email])
  @@index([storeId, notifiedAt])
}

/// Messagerie (comme Shopify Inbox) : une conversation par visiteur, retrouvée grâce à un jeton gardé dans son navigateur.
model Conversation {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  token         String        @unique // gardé par le navigateur du visiteur et dans le lien des e-mails de réponse
  email         String
  name          String
  status        String        @default("open") // open | closed
  unread        Int           @default(0) // messages du client pas encore lus par la boutique
  lastMessageAt DateTime      @default(now())
  notifiedAt    DateTime? // dernière alerte e-mail envoyée à la boutique
  createdAt     DateTime      @default(now())
  messages      ChatMessage[]

  @@index([storeId, lastMessageAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromCustomer   Boolean
  authorName     String
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// Champ personnalisé des produits (comme les métachamps Shopify) : matière, dimensions, entretien…
model MetafieldDefinition {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  key           String // identifiant stable (ex. « matiere »)
  name          String // libellé affiché (ex. « Matière »)
  type          String   @default("text") // text | multiline | number | boolean | choice
  choices       String   @default("[]") // JSON : valeurs possibles pour « choice »
  unit          String   @default("") // ex. « cm », « g »
  showOnProduct Boolean  @default(true) // tableau « Caractéristiques » sur la fiche produit
  filterable    Boolean  @default(false) // proposé dans les filtres de la boutique
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([storeId, key])
}

/// Connexion en attente du code de double authentification (mot de passe déjà vérifié).
model LoginChallenge {
  id        String   @id // empreinte du jeton gardé en cookie
  userId    String
  next      String   @default("/admin")
  attempts  Int      @default(0)
  expiresAt DateTime
}

/// Favori d'un client connecté (les visiteurs gardent leurs favoris dans le navigateur).
model Favorite {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([storeId, productId])
}

/// Erreur serveur (page, action ou API) : regroupée par signature, compteur d'occurrences, alerte e-mail limitée.
model ErrorLog {
  id         String    @id @default(cuid())
  signature  String    @unique
  message    String
  path       String
  method     String    @default("")
  kind       String    @default("") // render | route | action | middleware
  stack      String    @default("")
  count      Int       @default(1)
  resolved   Boolean   @default(false)
  firstAt    DateTime  @default(now())
  lastAt     DateTime  @default(now())
  notifiedAt DateTime?
}

/// Clé d'API d'une boutique (applications tierces). Seule son empreinte est gardée : la clé n'est montrée qu'une fois.
model ApiKey {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  prefix     String // début de la clé, pour la reconnaître dans la liste
  keyHash    String    @unique
  scopes     String    @default("[]") // JSON : droits accordés (read_products, write_orders…)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

/// Notification envoyée à une adresse externe quand un événement a lieu (commande payée, expédiée…).
model Webhook {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url        String
  topics     String    @default("[]") // JSON : événements suivis
  secret     String // clé de signature HMAC des envois
  createdAt  DateTime  @default(now())
  lastAt     DateTime?
  lastStatus Int? // code HTTP du dernier envoi (0 = pas de réponse)
  failures   Int       @default(0) // échecs consécutifs ; désactivé au-delà de 50
}

/// Emplacement de stock en plus de l'emplacement principal (boutique, dépôt, salon…).
model Location {
  id        String           @id @default(cuid())
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  address   String           @default("")
  createdAt DateTime         @default(now())
  levels    InventoryLevel[]
}

/// Quantité d'une variante dans un emplacement. L'emplacement principal n'a pas de ligne :
/// il détient le reste du stock total (Variant.stock moins les autres emplacements).
model InventoryLevel {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int      @default(0)

  @@unique([locationId, variantId])
}

/// Réglages de la plateforme enregistrés en base (ex. identifiants de l'application GitHub, chiffrés).
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Bibliothèque de thèmes de la boutique (comme sur Shopify) : le thème publié et des brouillons.
/// Les champs theme / customCss / translations de Store sont la copie du thème publié (lue par la vitrine).
model StoreTheme {
  id                  String    @id @default(cuid())
  storeId             String
  store               Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                String
  theme               String // JSON (même format que Store.theme)
  customCss           String    @default("")
  translations        String    @default("{}")
  source              String    @default("editor") // editor | preset | zip | github | copy
  engine              String    @default("native") // native (sections React) | liquid (thème Shopify importé, rendu par le moteur Liquid)
  version             Int       @default(1) // incrémenté à chaque changement de fichier (cache des gabarits)
  files               ThemeFile[]
  // Dépôt GitHub relié (connexion par l'application de la plateforme, ou jeton collé)
  githubRepo          String?
  githubBranch        String    @default("main")
  githubPath          String    @default("")
  githubToken         String? // jeton chiffré, mode « jeton collé »
  githubWebhookId     Int?
  githubWebhookSecret String?
  githubLastSha       String?
  githubSyncedAt      DateTime?
  githubError         String    @default("")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// Mesures de performance envoyées par les navigateurs des visiteurs (Core Web Vitals), une par chargement de page.
model WebVital {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lcp       Int? // ms
  inp       Int? // ms
  cls       Float? // valeur brute (ex. 0.05)
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

/// Visite d'une page de la vitrine (statistiques, attribution des ventes, vue en direct).
model PageView {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sessionId   String
  path        String
  referrer    String   @default("")
  utmSource   String   @default("")
  utmMedium   String   @default("")
  utmCampaign String   @default("")
  landing     Boolean  @default(false) // première page de la visite
  device      String   @default("") // mobile | desktop | tablet
  country     String   @default("") // nom français du pays (d'après l'adresse IP, via l'hébergeur)
  city        String   @default("")
  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([storeId, sessionId])
}

/// Visiteur présent en ce moment (battement de cœur toutes les 30 s).
model LiveVisitor {
  sessionId  String   @id
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  path       String   @default("")
  cartItems  Int      @default(0)
  country    String   @default("")
  city       String   @default("")
  lat        Float?
  lng        Float?
  lastSeenAt DateTime @default(now())

  @@index([storeId, lastSeenAt])
}

/// Historique des ajustements de stock (comme « Afficher l'historique des ajustements » sur Shopify).
model InventoryAdjustment {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta      Int
  after      Int
  reason     String // commande, remboursement, inventaire, transfert, réception fournisseur, API…
  author     String   @default("")
  locationId String?
  createdAt  DateTime @default(now())

  @@index([variantId, createdAt])
}

/// Chronologie d'un client (compte créé, commande, e-mail envoyé, note…).
model CustomerEvent {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String
  message    String   @default("")
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

/// Crédit en magasin : solde utilisable au paiement (remboursement en crédit, geste commercial).
model StoreCreditEntry {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deltaCents Int
  reason     String   @default("")
  orderId    String?
  author     String   @default("")
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

/// Bibliothèque de fichiers (Contenu → Fichiers) : chaque image ou vidéo envoyée.
/// Bibliothèque de thèmes de la plateforme (comme le Theme Store de Shopify) : thèmes Shopify déposés par
/// l'administrateur, proposés dans « Découvrir des thèmes » de chaque boutique et copiés à l'installation.
model PlatformTheme {
  id          String              @id @default(cuid())
  name        String
  version     String              @default("")
  author      String              @default("")
  description String              @default("")
  thumbnail   String? // capture d'écran affichée dans la galerie
  ready       Boolean             @default(false) // import terminé
  position    Int                 @default(0)
  createdAt   DateTime            @default(now())
  files       PlatformThemeFile[]
}

model PlatformThemeFile {
  id          String        @id @default(cuid())
  themeId     String
  theme       PlatformTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  path        String
  text        String?
  bytes       Bytes?
  contentType String        @default("")
  size        Int           @default(0)

  @@unique([themeId, path])
}

/// Fichier d'un thème Shopify importé (layout/, templates/, sections/, snippets/, config/, locales/, assets/).
model ThemeFile {
  id          String     @id @default(cuid())
  themeId     String
  theme       StoreTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  path        String // ex. "sections/header.liquid"
  text        String? // fichiers texte (liquid, json, css, js, svg)
  bytes       Bytes? // fichiers binaires (images, polices)
  contentType String     @default("")
  size        Int        @default(0)
  updatedAt   DateTime   @updatedAt

  @@unique([themeId, path])
}

model MediaFile {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url       String
  name      String
  alt       String   @default("")
  mime      String   @default("")
  size      Int      @default(0)
  width     Int      @default(0) // dimensions lues dans l'en-tête du fichier (ratio des images dans les thèmes)
  height    Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([storeId, url])
}

/// Vue enregistrée d'une liste (commandes, produits, clients) : des filtres gardés sous un nom, comme sur Shopify.
model SavedView {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  page      String // orders | products | customers
  name      String
  query     String // paramètres de la liste (ex. « tab=unpaid&channel=online »)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([storeId, page])
}

/// Marché (comme sur Shopify) : un groupe de pays avec sa devise, sa langue et un ajustement de prix.
model Market {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name           String
  countries      String   @default("[]") // JSON : noms de pays (voir src/lib/countries.ts)
  currency       String   @default("") // "" = devise de la boutique ; sinon une devise affichée (Paramètres → Devises)
  locale         String   @default("") // "" = langue principale ; sinon fr | en
  priceAdjustBps Int      @default(0) // ajustement des prix : +500 = +5 %, −1000 = −10 %
  enabled        Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([storeId])
}
