generator client {
  provider = "prisma-client-js"
}

// SQLite en local. Pour la mise en ligne, passez provider à "postgresql" (voir README).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  stores       Store[]
}

model Session {
  id        String   @id // hash SHA-256 du jeton du cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Store {
  id                    String       @id @default(cuid())
  slug                  String       @unique
  name                  String
  tagline               String       @default("")
  currency              String       @default("EUR")
  shippingCents         Int          @default(490)
  freeShippingFromCents Int          @default(6000)
  theme                 String       // JSON, voir src/lib/theme.ts
  themeUpdatedAt        DateTime?
  stripeAccountId       String?
  stripeChargesEnabled  Boolean      @default(false)
  ownerId               String
  owner                 User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt             DateTime     @default(now())
  products              Product[]
  collections           Collection[]
  orders                Order[]
  customers             Customer[]
  discounts             Discount[]
}

model Product {
  id          String              @id @default(cuid())
  storeId     String
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  handle      String
  description String              @default("")
  status      String              @default("draft") // draft | active
  images      String              @default("[]") // JSON: string[]
  options     String              @default("[]") // JSON: { name, values[] }[]
  hue         Int                 @default(160) // couleur du visuel quand il n'y a pas de photo
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  variants    Variant[]
  collections ProductCollection[]

  @@unique([storeId, handle])
}

model Variant {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String // "M / Bleu", ou "Par défaut"
  optionValues   String  @default("[]") // JSON: string[] dans l'ordre des options
  priceCents     Int
  compareAtCents Int?
  sku            String  @default("")
  stock          Int     @default(0)
  position       Int     @default(0)
}

model Collection {
  id          String              @id @default(cuid())
  storeId     String
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  handle      String
  description String              @default("")
  image       String?
  createdAt   DateTime            @default(now())
  products    ProductCollection[]

  @@unique([storeId, handle])
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email     String
  name      String
  note      String   @default("") // note interne, visible seulement dans l'admin
  createdAt DateTime @default(now())
  orders    Order[]

  @@unique([storeId, email])
}

model Discount {
  id               String    @id @default(cuid())
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code             String // toujours en majuscules
  type             String // percent | fixed
  value            Int // pourcentage, ou centimes pour fixed
  minSubtotalCents Int       @default(0)
  usageLimit       Int?
  usageCount       Int       @default(0)
  active           Boolean   @default(true)
  endsAt           DateTime?
  createdAt        DateTime  @default(now())

  @@unique([storeId, code])
}

model Order {
  id                String      @id @default(cuid())
  storeId           String
  store             Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  number            Int
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email             String
  name              String
  address           String // JSON: { line1, zip, city, country }
  note              String      @default("")
  paymentStatus     String      @default("pending") // pending | paid | refunded
  fulfillmentStatus String      @default("unfulfilled") // unfulfilled | fulfilled
  cancelledAt       DateTime?
  subtotalCents     Int
  discountCents     Int         @default(0)
  discountCode      String?
  shippingCents     Int
  totalCents        Int
  paymentMethod     String      @default("demo") // demo | stripe
  stripeSessionId   String?     @unique
  paidAt            DateTime?
  createdAt         DateTime    @default(now())
  items             OrderItem[]
  events            OrderEvent[]

  @@unique([storeId, number])
}

/// Chronologie d'une commande : actions du marchand et commentaires internes.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // comment | fulfilled | unfulfilled | cancelled | refunded
  message   String   @default("")
  author    String   @default("")
  createdAt DateTime @default(now())
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String? // pas de relation : la commande garde sa trace même si la variante est supprimée
  productTitle String
  variantTitle String
  priceCents   Int
  quantity     Int
  image        String?
  hue          Int     @default(160)
}
