{
  "name": "comptoir",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma.mjs generate && next build --webpack",
    "start": "next start",
    "check": "tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "node scripts/prisma.mjs db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "node scripts/prisma.mjs db push && tsx prisma/seed.ts",
    "postinstall": "node scripts/prisma.mjs generate"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "@vercel/blob": "2.8.1",
    "bcryptjs": "2.4.3",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "server-only": "^0.0.1",
    "stripe": "17.5.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.7",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "prisma": "6.2.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}
